# Resolvia Backend Environment Configuration
# ============================================

# Application Environment: 'dev' or 'prod'
APP_ENV=dev

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# ── Secrets Management (Optional overrides for AWS KMS / Secret Manager / Docker) ──
# If omitted, secrets are generated and stored in backend/secret/keys.json
# RESOLVIA_MASTER_KEY=your_64_character_hex_aes256_master_key
# RESOLVIA_JWT_SECRET=your_secure_random_jwt_secret_string

# ── Auth & OAuth ──────────────────────────────────
# Google OAuth Client ID (from Google Cloud Console)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Production SMTP Email Delivery (for Real OTP) ──
# In 'dev', codes are printed to console & returned in devCode.
# In 'prod', valid SMTP credentials are mandatory for login emails.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_key
# SMTP_FROM=arbitration-noreply@resolvia.org

# ── AI Advisory Engine (Multi-Provider) ───────────
# Provider 1: Google Gemini (Recommended)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# Provider 2: OpenAI / Groq / DeepSeek / OpenRouter
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Provider 3: Local Offline Ollama (Private / Zero External API)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Blockchain Configuration ───────────────────────
RESOLVIA_RPC=http://127.0.0.1:8545
RESOLVIA_CHAIN_ID=31337
# Sepolia Testnet alternative:
# RESOLVIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# RESOLVIA_CHAIN_ID=11155111

# Faucet / Operator account for gas auto-funding:
# RESOLVIA_OPERATOR_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── Cloud Database (MongoDB Atlas) ───────────────
# Optional: If omitted, runs seamlessly on local WAL-mode SQLite database
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=resolvia

# ── Decentralized IPFS Storage (Pinata) ──────────
# Optional: If omitted, falls back to deterministic SHA-256 content-addressing
# PINATA_JWT=your_pinata_jwt_bearer_token
# PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
