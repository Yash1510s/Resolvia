# Resolvia backend environment
# ── Auth ─────────────────────────────────────────────
# dev  : OTP printed to console + returned as devCode (demo)
# prod : real email OTP delivery, devCode never returned
APP_ENV=dev

# Google OAuth client ID (server-side ID token verification)
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# ── Chain ────────────────────────────────────────────
RESOLVIA_RPC=http://127.0.0.1:8545
RESOLVIA_CHAIN_ID=31337
# Account that funds new wallets with gas (hardhat account 0 by default)
# RESOLVIA_OPERATOR_KEY=0xac0974...
