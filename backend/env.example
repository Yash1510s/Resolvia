# ── Resolvia environment (copy to backend/.env and fill in) ──────────────────

# App
APP_ENV=dev                # dev (shows OTP devCode) | prod (real email required)
JWT_SECRET=change-me-64-hex-chars

# Google OAuth (optional — email OTP works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (required for APP_ENV=prod)
# Any SMTP relay: Gmail app password, Brevo, Resend SMTP, Mailgun, Postmark…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=you@yourdomain.com
OTP_VERIFY_URL=https://yourdomain.com/verify-otp

# ── Blockchain ───────────────────────────────────────────────────────────────
# Local Hardhat node (used by backend chain signing + frontend /api/rpc proxy)
CHAIN_RPC_URL=http://127.0.0.1:8545

# Sepolia deployment (blockchain/scripts/deploy-sepolia.js)
# Deployer key — TESTNET ONLY. Never commit a real key.
SEPOLIA_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── IPFS (pinning; prototype uses CID-only mode until keys are set) ──────────
PINATA_API_KEY=
PINATA_SECRET_KEY=
