# Resolvia Environment Variables Example
# Copy this file to .env or configure in your deployment environment

# Node / Frontend Configuration
PORT=3000
NEXT_PUBLIC_APP_NAME="Resolvia"
NEXT_PUBLIC_NETWORK="Ethereum Sepolia Testnet"

# Blockchain Configuration (Sepolia Testnet / Hardhat Local)
